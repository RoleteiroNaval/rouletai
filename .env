# ═══════════════════════════════════════════════════════════════
#  BANCO DE DADOS (OBRIGATÓRIO)
# ═══════════════════════════════════════════════════════════════

# URL completa do banco Neon PostgreSQL
DATABASE_URL=postgresql://neondb_owner:npg_O0LK7wWtqcaV@ep-plain-bar-anxtusji-pooler.c-6.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ═══════════════════════════════════════════════════════════════
#  SEGURANÇA (OBRIGATÓRIO)
# ═══════════════════════════════════════════════════════════════

# Secret para sessões do Express (32+ caracteres aleatórios)
SESSION_SECRET=4f8c9e2b5d7a1f6e3c8b9d2a4f7e1c5b8d9f2a3e6c7b1d4f8e2a9c3b6d5f7e1a4c8

# Secret para JWT (64+ caracteres aleatórios)
JWT_SECRET=2f9e8d4c7b1a5f3e9c6b8d2a4f7e1c5b9d3f8a2e6c4b7d1f5e9a3c8b6d2f4e7a1c5b9d8f2a3e6c4b7d1f5e8a9c3b6

# ═══════════════════════════════════════════════════════════════
#  CONFIGURAÇÃO BÁSICA DO SISTEMA
# ═══════════════════════════════════════════════════════════════

# Modo de execução (development/production)
NODE_ENV=development

# Porta do servidor principal
PORT=5001

# Porta do servidor agentic
AGENTIC_PORT=5000

# Configurações de risco padrão
DEFAULT_BANKROLL=1000
DEFAULT_BASE_STAKE=10
DEFAULT_MAX_STAKE=100
DEFAULT_MAX_LOSS=100

# ==========================================
# RAG SERVICE - PINECONE OU SUPABASE
# ==========================================

# Escolha o provedor: 'pinecone' ou 'supabase'
RAG_PROVIDER=supabase

# Configurações Pinecone (se usar pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_environment
RAG_INDEX_NAME=roulette-strategies
RAG_DIMENSION=1536

# Configurações Supabase (se usar supabase)
SUPABASE_PROJECT_URL=https://your-project.supabase.co
RAG_API_KEY=your_supabase_anon_key

# ==========================================
# MULTIMODAL - OCR + GEMINI
# ==========================================

# API Key do Google Gemini
GEMINI_API_KEY=your_key

ENABLE_DEEP_SCAN=true

ENABLE_VICIO_DETECTION=true

MIN_CONFIDENCE=0.70

MIN_CONFIDENCE_HIGH=0.90

VOICE_ENABLED=true

# Provedor OCR: 'tesseract' ou 'google_vision'
OCR_PROVIDER=tesseract

# API Key Google Vision (se usar google_vision)
GOOGLE_VISION_API_KEY=your_google_vision_api_key

# ==========================================
# BANCO DE DADOS (POSTGRES VIA DRIZZLE)
# ==========================================

# URL de conexão do banco
DATABASE_URL=postgresql://neondb_owner:npg_yLcSer8Zu6hR@ep-plain-bar-anxtusji-pooler.c-6.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ==========================================
# CONFIGURAÇÕES DE LOGGING E MONITORAMENTO
# ==========================================

# Nível de logging: 'info', 'warn', 'error', 'debug'
LOG_LEVEL=info

# Arquivo de logs (opcional)
LOG_FILE=logs/agentic.log

# ==========================================
# CONFIGURAÇÕES DE SEGURANÇA
# ==========================================

# JWT Secret para autenticação (futuro)
JWT_SECRET=your_jwt_secret_here

# Rate limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# CONFIGURAÇÕES DE PRODUÇÃO
# ==========================================

# URL do frontend Vision Pro
VISION_PRO_URL=http://localhost:3000

# Webhook URL para notificações
WEBHOOK_URL=https://your-webhook-url.com/notifications

# ═══════════════════════════════════════════════════════════════
#  TELEGRAM (OPCIONAL - para notificações)
# ═══════════════════════════════════════════════════════════════

# Token do bot — obtenha via @BotFather → /newbot
TELEGRAM_TOKEN=SEU_TOKEN_AQUI

# ID do chat/grupo onde os sinais são enviados
# Obtenha via @userinfobot → /start
TELEGRAM_CHAT_ID=SEU_CHAT_ID_AQUI

# ═══════════════════════════════════════════════════════════════
#  CONFIGURAÇÕES DE ROLETA
# ═══════════════════════════════════════════════════════════════

BET_AMOUNT=10
WAIT_ROUNDS_AFTER_WIN=3
WAIT_ROUNDS_AFTER_ZERO=5

# ═══════════════════════════════════════════════════════════════
#  LOGGING E MONITORAMENTO
# ═══════════════════════════════════════════════════════════════

LOG_LEVEL=info
LOG_FILE=logs/app.log

# ═══════════════════════════════════════════════════════════════
#  VARIÁVEIS PYTHON (LEGACY - manter compatibilidade)
# ═══════════════════════════════════════════════════════════════

DB_PATH=data/roulette.db

# ==========================================
# EXEMPLOS DE CONFIGURAÇÃO PRONTA
# ==========================================

# Para desenvolvimento local com mock services:
# RAG_PROVIDER= (deixe vazio para usar mock)
# GEMINI_API_KEY= (deixe vazio para desabilitar multimodal)
# OCR_PROVIDER=tesseract

# Para produção completa:
# RAG_PROVIDER=supabase
# SUPABASE_PROJECT_URL=https://xyz.supabase.co
# RAG_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# GEMINI_API_KEY=AIzaSy...
# OCR_PROVIDER=google_vision
# GOOGLE_VISION_API_KEY=AIzaSy...